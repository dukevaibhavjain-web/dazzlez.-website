# Copy to .env.local and fill in real values.

# ── Core ────────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=replace-with-a-32-byte-random-hex-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_DRIVER=console

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: point at your Docker/local Postgres instance
DATABASE_URI=postgres://dazzlez:dazzlez_dev@localhost:5432/dazzlez
# On Vercel, DATABASE_URL is auto-injected by Vercel Postgres (Neon)
# DATABASE_URL=

# ── Vercel Blob (media storage) ───────────────────────────────────────────────
# Get from Vercel dashboard → Storage → Blob → your store → .env.local button
# Leave blank locally to keep using local disk storage
BLOB_READ_WRITE_TOKEN=

# ── Payments (Cashfree) ───────────────────────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
